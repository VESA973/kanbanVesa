{% extends 'base.html.twig' %}

{% block title %}{{ 'member.title'|trans }} · {{ project.name }} · {{ parent() }}{% endblock %}

{% block body %}
    {% set can_manage = is_granted('PROJECT_MANAGE_MEMBERS', project) %}
    {% set members_token = csrf_token('members-' ~ project.id) %}

    <div class="mx-auto max-w-3xl">
        <twig:Link href="{{ path('app_project_show', {id: project.id}) }}" class="text-sm">← {{ 'member.back_to_board'|trans({'%project%': project.name}) }}</twig:Link>
        <h1 class="mt-2 mb-6 text-2xl font-bold tracking-tight">{{ 'member.title'|trans }}</h1>

        <section aria-labelledby="members-heading" class="rounded-lg bg-white shadow-sm ring-1 ring-slate-200 dark:bg-slate-900 dark:ring-slate-800">
            <h2 id="members-heading" class="sr-only">{{ 'member.title'|trans }}</h2>
            <ul class="divide-y divide-slate-200 dark:divide-slate-800">
                {% for member in project.members %}
                    <li class="flex flex-wrap items-center gap-3 p-4">
                        <twig:Avatar :user="member.user" />
                        <div class="min-w-0 flex-1">
                            <p class="truncate font-medium">{{ member.user.fullName }}</p>
                            <p class="truncate text-sm text-slate-500 dark:text-slate-400">{{ member.user.email }}</p>
                        </div>
                        {% if can_manage and member.role.value != 'owner' %}
                            <form method="post" action="{{ path('app_member_role', {id: member.id}) }}" class="flex items-center gap-2">
                                <input type="hidden" name="_token" value="{{ members_token }}">
                                <label for="role-{{ member.id }}" class="sr-only">{{ 'member.role_of'|trans({'%name%': member.user.fullName}) }}</label>
                                <select id="role-{{ member.id }}" name="role"
                                        class="rounded-md border border-slate-300 bg-white px-2 py-1.5 text-sm focus:outline-2 focus:outline-indigo-500 dark:border-slate-700 dark:bg-slate-800">
                                    {% for role in ['editor', 'viewer'] %}
                                        <option value="{{ role }}" {{ member.role.value == role ? 'selected' }}>{{ ('project.role.' ~ role)|trans }}</option>
                                    {% endfor %}
                                </select>
                                <twig:Button type="submit" variant="secondary">{{ 'action.save'|trans }}</twig:Button>
                            </form>
                            <form method="post" action="{{ path('app_member_remove', {id: member.id}) }}"
                                  data-controller="confirm" data-action="confirm#ask"
                                  data-confirm-message-value="{{ 'member.remove_confirm'|trans({'%name%': member.user.fullName}) }}">
                                <input type="hidden" name="_token" value="{{ members_token }}">
                                <twig:Button type="submit" variant="ghost">{{ 'member.remove'|trans }}<span class="sr-only"> {{ member.user.fullName }}</span></twig:Button>
                            </form>
                        {% else %}
                            <span class="rounded-full bg-slate-100 px-2 py-0.5 text-xs font-medium text-slate-700 dark:bg-slate-800 dark:text-slate-200">{{ member.role.translationKey|trans }}</span>
                        {% endif %}
                    </li>
                {% endfor %}
            </ul>
        </section>

        {% if can_manage %}
            <section aria-labelledby="invite-heading" class="mt-8 rounded-lg bg-white p-6 shadow-sm ring-1 ring-slate-200 dark:bg-slate-900 dark:ring-slate-800">
                <h2 id="invite-heading" class="mb-4 text-lg font-semibold">{{ 'invitation.title'|trans }}</h2>
                {{ form_start(form, {action: path('app_invitation_new', {id: project.id}), attr: {novalidate: 'novalidate'}}) }}
                    <div class="grid gap-x-4 sm:grid-cols-[1fr_12rem]">
                        {{ form_row(form.email) }}
                        {{ form_row(form.role) }}
                    </div>
                    <twig:Button type="submit">{{ 'invitation.submit'|trans }}</twig:Button>
                {{ form_end(form) }}
            </section>

            {% if invitations is not empty %}
                <section aria-labelledby="pending-heading" class="mt-8">
                    <h2 id="pending-heading" class="mb-3 text-lg font-semibold">{{ 'invitation.pending'|trans }}</h2>
                    <ul class="divide-y divide-slate-200 rounded-lg bg-white shadow-sm ring-1 ring-slate-200 dark:divide-slate-800 dark:bg-slate-900 dark:ring-slate-800">
                        {% for invitation in invitations %}
                            <li class="flex flex-wrap items-center gap-3 p-4 text-sm">
                                <div class="min-w-0 flex-1">
                                    <p class="truncate font-medium">{{ invitation.email }}</p>
                                    <p class="text-slate-500 dark:text-slate-400">
                                        {{ invitation.role.translationKey|trans }} · {{ 'invitation.expires_on'|trans({'%date%': invitation.expiresAt|date('d/m/Y')}) }}
                                    </p>
                                </div>
                                <form method="post" action="{{ path('app_invitation_revoke', {id: invitation.id}) }}">
                                    <input type="hidden" name="_token" value="{{ members_token }}">
                                    <twig:Button type="submit" variant="ghost">{{ 'invitation.revoke'|trans }}<span class="sr-only"> {{ invitation.email }}</span></twig:Button>
                                </form>
                            </li>
                        {% endfor %}
                    </ul>
                </section>
            {% endif %}
        {% endif %}
    </div>
{% endblock %}
