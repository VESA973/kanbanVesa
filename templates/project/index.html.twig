{% extends 'base.html.twig' %}

{% block title %}{{ 'project.index.title'|trans }} · {{ parent() }}{% endblock %}

{% block body %}
    <div class="mb-6 flex flex-wrap items-center justify-between gap-4">
        <h1 class="text-2xl font-bold tracking-tight">{{ 'project.index.title'|trans }}</h1>
        <div class="flex flex-wrap gap-3">
            <twig:Button variant="secondary" href="{{ path('app_pole_index') }}">{{ 'pole.manage'|trans }}</twig:Button>
            <twig:Button href="{{ path('app_program_new') }}">
                <span aria-hidden="true">+</span> {{ 'program.new.title'|trans }}
            </twig:Button>
        </div>
    </div>

    {% set has_poles = groups|filter(group => group.pole)|length > 0 %}
    {% set project_count = groups|reduce((count, group) => count + group.sections|length, 0) %}

    {% if has_poles %}
        <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3" aria-label="{{ 'pole.title'|trans }}">
            {% for group in groups %}
                <li><twig:PoleCard :group="group" /></li>
            {% endfor %}
            <li>
                <form method="post" action="{{ path('app_pole_new') }}"
                      class="flex h-full flex-col justify-center gap-2 rounded-lg border-2 border-dashed border-slate-300 p-4 dark:border-slate-700">
                    <input type="hidden" name="_token" value="{{ csrf_token('poles') }}">
                    <input type="hidden" name="_open" value="1">
                    <label for="pole-new-card" class="text-sm font-semibold">+ {{ 'pole.new_card'|trans }}</label>
                    <div class="flex gap-2">
                        <input id="pole-new-card" name="name" required maxlength="50" placeholder="{{ 'pole.new_placeholder'|trans }}"
                               class="block w-full min-w-0 rounded-md border border-slate-300 bg-white px-3 py-1.5 text-sm focus:outline-2 focus:outline-indigo-500 dark:border-slate-700 dark:bg-slate-800">
                        <twig:Button type="submit" variant="secondary">{{ 'pole.create'|trans }}</twig:Button>
                    </div>
                </form>
            </li>
        </ul>
    {% elseif project_count == 0 %}
        <div class="rounded-lg border-2 border-dashed border-slate-300 p-10 text-center dark:border-slate-700">
            <p class="text-slate-600 dark:text-slate-300">{{ 'project.index.empty'|trans }}</p>
        </div>
    {% else %}
        <div class="mb-6 flex flex-wrap items-center justify-between gap-3 rounded-lg bg-indigo-50 p-4 text-sm text-indigo-950 ring-1 ring-indigo-200 dark:bg-indigo-950 dark:text-indigo-100 dark:ring-indigo-900">
            <p><span aria-hidden="true">🗂️</span> {{ 'pole.invite'|trans }}</p>
            <form method="post" action="{{ path('app_pole_new') }}" class="flex gap-2">
                <input type="hidden" name="_token" value="{{ csrf_token('poles') }}">
                <input type="hidden" name="_open" value="1">
                <label for="pole-new-banner" class="sr-only">{{ 'pole.new'|trans }}</label>
                <input id="pole-new-banner" name="name" required maxlength="50" placeholder="{{ 'pole.new_placeholder'|trans }}"
                       class="block w-48 rounded-md border border-indigo-300 bg-white px-3 py-1.5 text-sm text-slate-900 focus:outline-2 focus:outline-indigo-500 dark:border-indigo-800 dark:bg-slate-900 dark:text-slate-100">
                <twig:Button type="submit">{{ 'pole.create'|trans }}</twig:Button>
            </form>
        </div>
        <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {% for group in groups %}
                {% for section in group.sections %}
                    <li><twig:ProgramCard :section="section" /></li>
                {% endfor %}
            {% endfor %}
        </ul>
    {% endif %}

    {% if archivedProjects is not empty %}
        <details class="mt-10">
            <summary class="cursor-pointer rounded text-sm font-semibold text-slate-600 focus-visible:outline-2 focus-visible:outline-indigo-600 dark:text-slate-300">
                {{ 'project.archive.list'|trans({'%count%': archivedProjects|length}) }}
            </summary>
            <ul class="mt-3 divide-y divide-slate-200 rounded-lg bg-white shadow-sm ring-1 ring-slate-200 dark:divide-slate-800 dark:bg-slate-900 dark:ring-slate-800">
                {% for project in archivedProjects %}
                    <li class="flex items-center gap-3 p-3 text-sm">
                        <twig:ProjectColorSwatch :color="project.color.value" size="sm" />
                        <twig:Link href="{{ path('app_project_show', {id: project.id}) }}" class="flex-1">{{ project.name }}</twig:Link>
                        <span class="text-xs text-slate-500 dark:text-slate-400">{{ 'project.archive.archived_on'|trans({'%date%': project.archivedAt|date('d/m/Y')}) }}</span>
                    </li>
                {% endfor %}
            </ul>
        </details>
    {% endif %}
{% endblock %}
