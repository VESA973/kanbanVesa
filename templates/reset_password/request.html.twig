{% extends 'base.html.twig' %}

{% block title %}{{ 'auth.reset_request.title'|trans }} · {{ parent() }}{% endblock %}

{% block body %}
    <twig:AuthCard title="{{ 'auth.reset_request.title'|trans }}">
        <p class="mb-4 text-sm text-slate-600 dark:text-slate-300">{{ 'auth.reset_request.intro'|trans }}</p>
        {{ form_start(form, {attr: {novalidate: 'novalidate'}}) }}
            {{ form_row(form.email) }}
            <twig:Button type="submit" fullWidth>{{ 'auth.reset_request.submit'|trans }}</twig:Button>
        {{ form_end(form) }}

        <twig:block name="footer">
            <p class="mt-4 text-center text-sm">
                <twig:Link href="{{ path('app_login') }}">{{ 'auth.back_to_login'|trans }}</twig:Link>
            </p>
        </twig:block>
    </twig:AuthCard>
{% endblock %}
