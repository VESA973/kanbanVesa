{% extends 'base.html.twig' %}

{% block title %}{{ 'program.new.title'|trans }} · {{ parent() }}{% endblock %}

{% block body %}
    <div class="mx-auto max-w-2xl">
        <h1 class="mb-2 text-2xl font-bold tracking-tight">{{ 'program.new.title'|trans }}</h1>
        <p class="mb-6 text-slate-600 dark:text-slate-300">{{ 'program.new.help'|trans }}</p>
        <div class="rounded-lg bg-white p-6 shadow-sm ring-1 ring-slate-200 dark:bg-slate-900 dark:ring-slate-800">
            {{ include('project/_form.html.twig', {submit_label: 'program.new.submit', cancel_path: path('app_project_index')}) }}
        </div>
    </div>
{% endblock %}
