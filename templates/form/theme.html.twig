{% use 'form_div_layout.html.twig' %}

{%- block form_row -%}
    {%- set widget_attr = {} -%}
    {%- if help is not empty -%}
        {%- set widget_attr = {attr: {'aria-describedby': id ~ '_help'}} -%}
    {%- endif -%}
    <div class="mb-4">
        {{- form_label(form) -}}
        {{- form_widget(form, widget_attr) -}}
        {{- form_help(form) -}}
        {{- form_errors(form) -}}
    </div>
{%- endblock form_row -%}

{%- block form_label -%}
    {%- set label_attr = label_attr|merge({class: (label_attr.class|default('') ~ ' mb-1 block text-sm font-medium text-slate-700 dark:text-slate-200')|trim}) -%}
    {{- parent() -}}
{%- endblock form_label -%}

{%- block form_widget_simple -%}
    {%- set attr = attr|merge({
        class: (attr.class|default('') ~ ' block w-full rounded-md border bg-white px-3 py-2 text-sm text-slate-900 shadow-xs placeholder:text-slate-400 focus:border-indigo-500 focus:outline-2 focus:outline-indigo-500 dark:bg-slate-800 dark:text-slate-100 '
            ~ (errors|length > 0 ? 'border-red-500 dark:border-red-400' : 'border-slate-300 dark:border-slate-700'))|trim,
    }) -%}
    {%- if errors|length > 0 -%}
        {%- set attr = attr|merge({'aria-invalid': 'true'}) -%}
    {%- endif -%}
    {{- parent() -}}
{%- endblock form_widget_simple -%}

{%- block form_help -%}
    {%- if help is not empty -%}
        <p id="{{ id }}_help" class="mt-1 text-xs text-slate-500 dark:text-slate-400">{{ help|trans(help_translation_parameters, translation_domain) }}</p>
    {%- endif -%}
{%- endblock form_help -%}

{%- block form_errors -%}
    {%- if errors|length > 0 -%}
        <ul class="mt-1 space-y-0.5 text-sm text-red-600 dark:text-red-400">
            {%- for error in errors -%}
                <li>{{ error.message }}</li>
            {%- endfor -%}
        </ul>
    {%- endif -%}
{%- endblock form_errors -%}

{%- block project_color_widget -%}
    <div {{ block('widget_container_attributes') }} role="radiogroup" aria-labelledby="{{ id }}_label" class="flex flex-wrap gap-3">
        {%- for child in form -%}
            <label class="cursor-pointer">
                <input type="radio" id="{{ child.vars.id }}" name="{{ child.vars.full_name }}" value="{{ child.vars.value }}"
                       {{ child.vars.checked ? 'checked' }} class="peer sr-only">
                <span class="flex items-center gap-2 rounded-full px-3 py-1.5 text-sm ring-1 ring-slate-300 peer-checked:ring-2 peer-checked:ring-indigo-600 peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-indigo-600 dark:ring-slate-700 dark:peer-checked:ring-indigo-400">
                    <twig:ProjectColorSwatch :color="child.vars.value" size="sm" />
                    {{ child.vars.label|trans }}
                </span>
            </label>
        {%- endfor -%}
    </div>
{%- endblock project_color_widget -%}

{%- block project_color_label -%}
    {%- set label_attr = label_attr|merge({class: 'mb-2 block text-sm font-medium text-slate-700 dark:text-slate-200'}) -%}
    <span id="{{ id }}_label" {% with {attr: label_attr} %}{{ block('attributes') }}{% endwith %}>{{ label|trans(label_translation_parameters, translation_domain) }}</span>
{%- endblock project_color_label -%}

{%- block textarea_widget -%}
    {%- set attr = attr|merge({
        class: (attr.class|default('') ~ ' block w-full rounded-md border bg-white px-3 py-2 text-sm text-slate-900 shadow-xs focus:border-indigo-500 focus:outline-2 focus:outline-indigo-500 dark:bg-slate-800 dark:text-slate-100 '
            ~ (errors|length > 0 ? 'border-red-500 dark:border-red-400' : 'border-slate-300 dark:border-slate-700'))|trim,
    }) -%}
    {{- parent() -}}
{%- endblock textarea_widget -%}

{%- block choice_widget_collapsed -%}
    {%- set attr = attr|merge({class: (attr.class|default('') ~ ' block w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-xs focus:border-indigo-500 focus:outline-2 focus:outline-indigo-500 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-100')|trim}) -%}
    {{- parent() -}}
{%- endblock choice_widget_collapsed -%}

{%- block chip_choices_widget -%}
    <div {{ block('widget_container_attributes') }} role="group" aria-labelledby="{{ id }}_label" class="flex flex-wrap gap-2">
        {%- for child in form -%}
            <label class="flex cursor-pointer items-center gap-1.5 rounded-full px-2.5 py-1 text-sm ring-1 ring-slate-300 has-checked:ring-2 has-checked:ring-indigo-600 dark:ring-slate-700 dark:has-checked:ring-indigo-400">
                <input type="checkbox" id="{{ child.vars.id }}" name="{{ child.vars.full_name }}" value="{{ child.vars.value }}" {{ child.vars.checked ? 'checked' }}
                       class="size-3.5 accent-indigo-600 focus-visible:outline-2 focus-visible:outline-indigo-600">
                {{ child.vars.label }}
            </label>
        {%- endfor -%}
    </div>
{%- endblock chip_choices_widget -%}

{%- block chip_choices_label -%}
    <span id="{{ id }}_label" class="mb-2 block text-sm font-medium text-slate-700 dark:text-slate-200">{{ label|trans(label_translation_parameters, translation_domain) }}</span>
{%- endblock chip_choices_label -%}
