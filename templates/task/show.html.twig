{% extends app.request.headers.has('Turbo-Frame') ? 'task/_modal.html.twig' : 'task/_page.html.twig' %}

{% block modal_title %}{{ task.title }}{% endblock %}

{% block modal_body %}
    <div class="mb-6 flex flex-wrap items-center gap-3">
        {% if is_granted('TASK_COMPLETE', task) %}
            <form method="post" action="{{ path('app_task_toggle', {id: task.id}) }}" data-turbo-frame="_top">
                <input type="hidden" name="_token" value="{{ csrf_token('toggle-task-' ~ task.id) }}">
                <input type="hidden" name="_return_to" value="{{ path('app_project_show', {id: task.project.id}) }}">
                <twig:Button type="submit" variant="{{ task.completed ? 'secondary' : 'primary' }}">
                    {{ (task.completed ? 'task.reopen' : 'task.complete')|trans }}
                </twig:Button>
            </form>
        {% endif %}
        {% if task.completed %}
            <span class="rounded-full bg-emerald-100 px-2 py-0.5 text-xs font-medium text-emerald-800 dark:bg-emerald-900 dark:text-emerald-200">
                {{ 'task.completed_on'|trans({'%date%': task.completedAt|date('d/m/Y')}) }}
            </span>
        {% endif %}
    </div>

    <dl class="mb-6 grid grid-cols-2 gap-x-4 gap-y-3 text-sm sm:grid-cols-3">
        <div>
            <dt class="text-slate-500 dark:text-slate-400">{{ 'task.column'|trans }}</dt>
            <dd class="font-medium">{{ task.column.name }}</dd>
        </div>
        <div>
            <dt class="text-slate-500 dark:text-slate-400">{{ 'task.assignee'|trans }}</dt>
            <dd class="font-medium">{{ task.assignee ? task.assignee.fullName : 'task.unassigned'|trans }}</dd>
        </div>
        <div>
            <dt class="text-slate-500 dark:text-slate-400">{{ 'task.due_date'|trans }}</dt>
            <dd class="font-medium">{% if task.dueDate %}<twig:DueDate :task="task" />{% else %}—{% endif %}</dd>
        </div>
        <div>
            <dt class="text-slate-500 dark:text-slate-400">{{ 'task.priority.label'|trans }}</dt>
            <dd><twig:PriorityBadge :priority="task.priority" /></dd>
        </div>
        <div>
            <dt class="text-slate-500 dark:text-slate-400">{{ 'task.created_by'|trans }}</dt>
            <dd class="font-medium">{{ task.createdBy ? task.createdBy.fullName : 'tracking.former_member'|trans }}</dd>
        </div>
        <div>
            <dt class="text-slate-500 dark:text-slate-400">{{ 'task.created_at'|trans }}</dt>
            <dd class="font-medium">{{ task.createdAt|date('d/m/Y') }}</dd>
        </div>
    </dl>

    {% if is_granted('TASK_EDIT', task) %}
        {{ form_start(form, {action: path('app_task_show', {id: task.id}), attr: {novalidate: 'novalidate', 'data-turbo-frame': '_top'}}) }}
            {{ form_row(form.title) }}
            {{ form_row(form.description) }}
            <div class="grid gap-x-4 sm:grid-cols-2">
                {{ form_row(form.assignee) }}
                {{ form_row(form.dueDate) }}
                {{ form_row(form.priority) }}
                {{ form_row(form.category) }}
                {{ form_row(form.column) }}
            </div>
            {% if form.labels|length > 0 %}
                {{ form_row(form.labels) }}
            {% else %}
                {% do form.labels.setRendered %}
            {% endif %}
            <twig:Button type="submit">{{ 'action.save'|trans }}</twig:Button>
        {{ form_end(form) }}

        <form method="post" action="{{ path('app_task_delete', {id: task.id}) }}" data-turbo-frame="_top" class="mt-6 border-t border-slate-200 pt-4 dark:border-slate-800"
              data-controller="confirm" data-action="confirm#ask" data-confirm-message-value="{{ 'task.delete_confirm'|trans }}">
            <input type="hidden" name="_token" value="{{ csrf_token('board-' ~ task.project.id) }}">
            <twig:Button type="submit" variant="danger">{{ 'task.delete'|trans }}</twig:Button>
        </form>
    {% else %}
        {% if task.labels is not empty %}
            <div class="mb-4 flex flex-wrap gap-1">{% for label in task.labels %}<twig:LabelChip :label="label" />{% endfor %}</div>
        {% endif %}
        <h3 class="mb-1 text-sm font-semibold">{{ 'task.description'|trans }}</h3>
        <p class="whitespace-pre-line text-sm text-slate-700 dark:text-slate-300">{{ task.description ?: 'task.no_description'|trans }}</p>
    {% endif %}

    {{ include('task/_invite.html.twig') }}
    {{ include('task/_checklist.html.twig') }}
    {{ include('task/_comments.html.twig') }}
{% endblock %}
