{# Layout used when the task is loaded into the board's "modal" Turbo Frame. #}
<turbo-frame id="modal">
    {# Resizable by its bottom-right corner (sm and up); the width chosen is remembered by the browser. #}
    <dialog data-controller="modal" data-action="click->modal#closeOnBackdrop"
            aria-labelledby="modal-title"
            class="m-auto w-full max-w-[95vw] overflow-hidden rounded-lg bg-white p-0 text-slate-900 shadow-xl backdrop:bg-slate-900/50 sm:w-[48rem] sm:min-w-[24rem] sm:resize-x dark:bg-slate-900 dark:text-slate-100">
        <div class="max-h-[85vh] overflow-y-auto p-6" data-modal-target="body">
            <div class="mb-4 flex items-start justify-between gap-4">
                <h2 id="modal-title" class="text-xl font-bold break-words">{% block modal_title %}{% endblock %}</h2>
                <div class="flex shrink-0 items-center gap-1">
                    <button type="button" data-action="modal#toggleWide" data-modal-target="wideButton" aria-pressed="false"
                            class="hidden rounded p-1 text-slate-500 hover:bg-slate-100 focus-visible:outline-2 focus-visible:outline-indigo-600 sm:block dark:hover:bg-slate-800">
                        <span aria-hidden="true">⤢</span><span class="sr-only">{{ 'action.toggle_wide'|trans }}</span>
                    </button>
                    <button type="button" data-action="modal#close" class="rounded p-1 text-slate-500 hover:bg-slate-100 focus-visible:outline-2 focus-visible:outline-indigo-600 dark:hover:bg-slate-800">
                        <span aria-hidden="true">✕</span><span class="sr-only">{{ 'action.close'|trans }}</span>
                    </button>
                </div>
            </div>
            {% block modal_body %}{% endblock %}
        </div>
    </dialog>
</turbo-frame>
