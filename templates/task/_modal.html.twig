{# Layout used when the task is loaded into the board's "modal" Turbo Frame. #}
<turbo-frame id="modal">
    <dialog data-controller="modal" data-action="click->modal#closeOnBackdrop"
            aria-labelledby="modal-title"
            class="m-auto w-full max-w-2xl rounded-lg bg-white p-0 text-slate-900 shadow-xl backdrop:bg-slate-900/50 dark:bg-slate-900 dark:text-slate-100">
        <div class="max-h-[85vh] overflow-y-auto p-6">
            <div class="mb-4 flex items-start justify-between gap-4">
                <h2 id="modal-title" class="text-xl font-bold break-words">{% block modal_title %}{% endblock %}</h2>
                <button type="button" data-action="modal#close" class="rounded p-1 text-slate-500 hover:bg-slate-100 focus-visible:outline-2 focus-visible:outline-indigo-600 dark:hover:bg-slate-800">
                    <span aria-hidden="true">✕</span><span class="sr-only">{{ 'action.close'|trans }}</span>
                </button>
            </div>
            {% block modal_body %}{% endblock %}
        </div>
    </dialog>
</turbo-frame>
