{# Rename, move or delete a column; expects `column`, `table` and `task_token`.
   A popover (top layer) rather than a dropdown: the table scrolls horizontally and would clip it. #}
<button type="button" popovertarget="column-menu-{{ column.id }}"
        class="rounded px-1 font-normal text-slate-400 hover:bg-slate-200 focus-visible:outline-2 focus-visible:outline-indigo-600 dark:hover:bg-slate-700">
    <span aria-hidden="true">▾</span><span class="sr-only">{{ 'task_table.column_actions'|trans({'%name%': column.name}) }}</span>
</button>
<div id="column-menu-{{ column.id }}" popover aria-label="{{ 'task_table.column_actions'|trans({'%name%': column.name}) }}"
     class="m-auto w-72 max-w-[90vw] space-y-3 rounded-lg bg-white p-4 text-left text-sm font-normal text-slate-900 shadow-xl ring-1 ring-slate-200 backdrop:bg-slate-900/20 dark:bg-slate-800 dark:text-slate-100 dark:ring-slate-700">
        <div class="flex items-center justify-between gap-2">
            <p class="font-semibold">{{ column.name }} <span class="font-normal text-slate-500 dark:text-slate-400">· {{ column.type.translationKey|trans }}</span></p>
            <button type="button" popovertarget="column-menu-{{ column.id }}" popovertargetaction="hide" class="rounded p-1 text-slate-500 hover:bg-slate-100 dark:hover:bg-slate-700">
                <span aria-hidden="true">✕</span><span class="sr-only">{{ 'action.close'|trans }}</span>
            </button>
        </div>
        <form method="post" action="{{ path('app_task_table_column_rename', {id: column.id}) }}">
            <input type="hidden" name="_token" value="{{ task_token }}">
            <label for="column-rename-{{ column.id }}" class="mb-1 block text-xs font-medium">{{ 'task_table.rename_column'|trans }}</label>
            <div class="flex gap-2">
                <input id="column-rename-{{ column.id }}" name="name" value="{{ column.name }}" required maxlength="50"
                       class="block w-full rounded-md border border-slate-300 bg-white px-2 py-1 text-sm dark:border-slate-700 dark:bg-slate-900">
                <twig:Button type="submit" variant="secondary">{{ 'action.save'|trans }}</twig:Button>
            </div>
        </form>
        <div class="flex gap-2">
            {% for step, label in {'-1': 'task_table.move_left', '1': 'task_table.move_right'} %}
                {% set disabled = (step == -1 and column.position == 0) or (step == 1 and column.position == table.columns|length - 1) %}
                <form method="post" action="{{ path('app_task_table_column_move', {id: column.id}) }}" class="flex-1">
                    <input type="hidden" name="_token" value="{{ task_token }}">
                    <input type="hidden" name="step" value="{{ step }}">
                    <twig:Button type="submit" variant="secondary" fullWidth :disabled="disabled">{{ label|trans }}</twig:Button>
                </form>
            {% endfor %}
        </div>
        {% if table.columns|length > 1 %}
            <form method="post" action="{{ path('app_task_table_column_delete', {id: column.id}) }}"
                  data-controller="confirm" data-action="confirm#ask"
                  data-confirm-message-value="{{ 'task_table.delete_column_confirm'|trans({'%name%': column.name}) }}">
                <input type="hidden" name="_token" value="{{ task_token }}">
                <twig:Button type="submit" variant="danger" fullWidth>{{ 'task_table.delete_column'|trans }}</twig:Button>
            </form>
        {% endif %}
</div>
