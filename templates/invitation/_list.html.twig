{# Invitations of a project or a program; expects `invitations` and `members_token`. #}
{% if invitations is not empty %}
    <section aria-labelledby="invitations-heading" class="mt-8">
        <h2 id="invitations-heading" class="mb-3 text-lg font-semibold">{{ 'invitation.list_title'|trans }}</h2>
        <ul class="divide-y divide-slate-200 rounded-lg bg-white shadow-sm ring-1 ring-slate-200 dark:divide-slate-800 dark:bg-slate-900 dark:ring-slate-800">
            {% for invitation in invitations %}
                {% set status = invitation.status.value %}
                <li class="flex flex-wrap items-center gap-3 p-4 text-sm">
                    <div class="min-w-0 flex-1">
                        <p class="flex flex-wrap items-center gap-2">
                            <span class="truncate font-medium">{{ invitation.email }}</span>
                            <span class="rounded-full px-2 py-0.5 text-xs font-medium {{ {
                                pending: 'bg-amber-100 text-amber-900 dark:bg-amber-900/40 dark:text-amber-100',
                                accepted: 'bg-emerald-100 text-emerald-900 dark:bg-emerald-900/40 dark:text-emerald-100',
                                expired: 'bg-slate-200 text-slate-700 dark:bg-slate-700 dark:text-slate-200',
                            }[status] }}">{{ invitation.status.translationKey|trans }}</span>
                        </p>
                        <p class="text-slate-500 dark:text-slate-400">
                            {{ invitation.role.translationKey|trans }} ·
                            {% if status == 'accepted' %}
                                {{ 'invitation.accepted_on'|trans({'%date%': invitation.acceptedAt|date('d/m/Y')}) }}
                            {% elseif status == 'expired' %}
                                {{ 'invitation.expired_on'|trans({'%date%': invitation.expiresAt|date('d/m/Y')}) }}
                            {% else %}
                                {{ 'invitation.expires_on'|trans({'%date%': invitation.expiresAt|date('d/m/Y')}) }}
                            {% endif %}
                            {% if invitation.task %}· {{ 'invitation.for_task'|trans({'%task%': invitation.task.title}) }}{% endif %}
                        </p>
                    </div>
                    {% if status != 'accepted' %}
                        {% if status == 'pending' %}
                            <form method="post" action="{{ path('app_invitation_link', {id: invitation.id}) }}" data-turbo-frame="modal">
                                <input type="hidden" name="_token" value="{{ members_token }}">
                                <twig:Button type="submit" variant="ghost">🔗 {{ 'invitation.link.get'|trans }}<span class="sr-only"> {{ invitation.email }}</span></twig:Button>
                            </form>
                        {% endif %}
                        <form method="post" action="{{ path('app_invitation_resend', {id: invitation.id}) }}">
                            <input type="hidden" name="_token" value="{{ members_token }}">
                            <twig:Button type="submit" variant="ghost">{{ 'invitation.resend'|trans }}<span class="sr-only"> {{ invitation.email }}</span></twig:Button>
                        </form>
                        <form method="post" action="{{ path('app_invitation_revoke', {id: invitation.id}) }}">
                            <input type="hidden" name="_token" value="{{ members_token }}">
                            <twig:Button type="submit" variant="ghost">{{ 'invitation.revoke'|trans }}<span class="sr-only"> {{ invitation.email }}</span></twig:Button>
                        </form>
                    {% endif %}
                </li>
            {% endfor %}
        </ul>
    </section>
{% endif %}
