{% extends 'email/layout.html.twig' %}

{% block content %}
    <p>{{ 'email.invitation.intro'|trans({'%inviter%': inviterName, '%project%': projectName, '%role%': roleKey|trans}) }}</p>
    <p style="margin:24px 0;">
        <a href="{{ url('app_invitation_show', {token: token}) }}" style="background:#4f46e5;color:#ffffff;padding:12px 20px;border-radius:6px;text-decoration:none;font-weight:bold;">{{ 'email.invitation.button'|trans }}</a>
    </p>
    <p style="font-size:13px;color:#64748b;">{{ 'email.invitation.expires'|trans({'%date%': expiresAt|date('d/m/Y')}) }}</p>
{% endblock %}
