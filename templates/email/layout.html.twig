{# E-mail clients ignore external stylesheets: minimal inline styles are the exception to Tailwind here. #}
<!DOCTYPE html>
<html lang="fr">
<body style="margin:0;padding:24px;background:#f8fafc;font-family:Arial,Helvetica,sans-serif;color:#0f172a;">
    <div style="max-width:560px;margin:0 auto;background:#ffffff;border-radius:8px;padding:32px;">
        <p style="margin:0 0 24px;font-size:20px;font-weight:bold;color:#4f46e5;">{{ 'app.name'|trans }}</p>
        {% block content %}{% endblock %}
    </div>
</body>
</html>
