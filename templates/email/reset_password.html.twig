{% extends 'email/layout.html.twig' %}

{% block content %}
    <p>{{ 'email.greeting'|trans({'%name%': firstName}) }}</p>
    <p>{{ 'email.reset_password.intro'|trans }}</p>
    <p style="margin:24px 0;">
        <a href="{{ url('app_reset_password_token', {token: token}) }}" style="background:#4f46e5;color:#ffffff;padding:12px 20px;border-radius:6px;text-decoration:none;font-weight:bold;">{{ 'email.reset_password.button'|trans }}</a>
    </p>
    <p style="font-size:13px;color:#64748b;">{{ 'email.expires'|trans({'%expires%': expiresAtMessageKey|trans(expiresAtMessageData, 'ResetPasswordBundle')}) }}</p>
    <p style="font-size:13px;color:#64748b;">{{ 'email.reset_password.ignore'|trans }}</p>
{% endblock %}
