{# A program on "Mes projets": its image, overall progress and number of chantiers. #}
{% props section %}
{% set program = section.program %}
<article class="relative flex h-full flex-col overflow-hidden rounded-lg bg-white shadow-sm ring-1 ring-slate-200 transition hover:shadow-md focus-within:ring-2 focus-within:ring-indigo-500 dark:bg-slate-900 dark:ring-slate-800">
    {% if program.imageFilename %}
        <img src="{{ path('app_program_image', {id: program.id, v: program.imageFilename}) }}" alt="" loading="lazy"
             class="aspect-[16/9] w-full object-cover">
    {% else %}
        <twig:ProjectColorSwatch :color="program.color.value" size="bar" class="rounded-none" />
    {% endif %}
    <div class="flex flex-1 flex-col gap-3 p-4">
        <h2 class="text-base font-semibold">
            <a href="{{ path('app_program_show', {id: program.id}) }}" class="after:absolute after:inset-0 focus-visible:outline-none">{{ program.name }}</a>
        </h2>
        {% if program.description %}
            <p class="line-clamp-2 text-sm text-slate-600 dark:text-slate-300">{{ program.description }}</p>
        {% endif %}
        <twig:ProgressBar :progress="section.overall()" :label="'progress.overall_of'|trans({'%name%': program.name})" />
        <p class="mt-auto flex items-center justify-between gap-2 text-xs text-slate-500 dark:text-slate-400">
            <span>{{ 'program.chantier_count'|trans({'%count%': section.projects|length}) }}</span>
            {% if section.isMember %}
                <span class="rounded-full bg-slate-100 px-2 py-0.5 font-medium text-slate-700 dark:bg-slate-800 dark:text-slate-200">{{ program.roleOf(app.user).translationKey|trans }}</span>
            {% endif %}
        </p>
    </div>
</article>
