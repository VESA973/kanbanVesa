{% props user %}
<span title="{{ user.fullName }}" {{ attributes.defaults({class: 'inline-flex size-7 items-center justify-center rounded-full bg-slate-200 text-xs font-semibold text-slate-700 ring-2 ring-white dark:bg-slate-700 dark:text-slate-100 dark:ring-slate-900'}) }}>
    <span aria-hidden="true">{{ user.firstName|first|upper }}{{ user.lastName|first|upper }}</span>
    <span class="sr-only">{{ user.fullName }}</span>
</span>
