{% props project %}
<article class="relative flex h-full flex-col overflow-hidden rounded-lg bg-white shadow-sm ring-1 ring-slate-200 transition hover:shadow-md focus-within:ring-2 focus-within:ring-indigo-500 dark:bg-slate-900 dark:ring-slate-800">
    <twig:ProjectColorSwatch :color="project.color.value" size="bar" class="rounded-none" />
    <div class="flex flex-1 flex-col gap-3 p-4">
        <h2 class="text-base font-semibold">
            <a href="{{ path('app_project_show', {id: project.id}) }}" class="after:absolute after:inset-0 focus-visible:outline-none">{{ project.name }}</a>
        </h2>
        {% if project.description %}
            <p class="line-clamp-2 text-sm text-slate-600 dark:text-slate-300">{{ project.description }}</p>
        {% endif %}
        <div class="mt-auto flex items-center justify-between gap-2">
            <div class="flex -space-x-2">
                {% for member in project.members|slice(0, 5) %}
                    <twig:Avatar :user="member.user" />
                {% endfor %}
            </div>
            <span class="rounded-full bg-slate-100 px-2 py-0.5 text-xs font-medium text-slate-700 dark:bg-slate-800 dark:text-slate-200">
                {{ project.roleOf(app.user).translationKey|trans }}
            </span>
        </div>
    </div>
</article>
