{% props users, max = 3 %}{# users: iterable of User; the ones beyond max are summed up as "+n" #}
<span {{ attributes.defaults({class: 'flex items-center -space-x-2'}) }}>
    {% for user in users|slice(0, max) %}
        <twig:Avatar :user="user" />
    {% endfor %}
    {% if users|length > max %}
        {% set others = users|slice(max) %}
        <span title="{{ others|map(u => u.fullName)|join(', ') }}"
              class="inline-flex size-7 items-center justify-center rounded-full bg-slate-300 text-xs font-semibold text-slate-700 ring-2 ring-white dark:bg-slate-600 dark:text-slate-100 dark:ring-slate-900">
            <span aria-hidden="true">+{{ others|length }}</span>
            <span class="sr-only">{{ others|map(u => u.fullName)|join(', ') }}</span>
        </span>
    {% endif %}
</span>
