{% props priority %}
{% set styles = {
    low: 'bg-slate-100 text-slate-700 dark:bg-slate-700 dark:text-slate-200',
    medium: 'bg-sky-100 text-sky-800 dark:bg-sky-900 dark:text-sky-200',
    high: 'bg-amber-100 text-amber-800 dark:bg-amber-900 dark:text-amber-200',
    urgent: 'bg-red-100 text-red-800 dark:bg-red-900 dark:text-red-200',
} %}
<span class="rounded px-1.5 py-0.5 font-medium {{ styles[priority.value] }}">{{ priority.translationKey|trans }}</span>
