<header class="border-b border-slate-200 bg-white dark:border-slate-800 dark:bg-slate-900">
    <nav class="mx-auto flex h-14 max-w-7xl items-center justify-between gap-4 px-4 sm:px-6 lg:px-8" aria-label="{{ 'nav.main'|trans }}">
        <div class="flex items-center gap-2 sm:gap-6">
        <a href="{{ path('app_home') }}" class="flex items-center gap-2 rounded text-lg font-semibold text-indigo-600 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600 dark:text-indigo-400">
            <span aria-hidden="true">📋</span> {{ 'app.name'|trans }}
        </a>
        {% if app.user %}
            {% for route, label in {app_project_index: 'nav.projects', app_my_tasks: 'nav.my_tasks'} %}
                {% set current = app.current_route == route or (route == 'app_project_index' and app.current_route starts with 'app_project') %}
                <a href="{{ path(route) }}" {{ current ? 'aria-current="page"' }}
                   class="rounded px-2 py-1 text-sm font-medium focus-visible:outline-2 focus-visible:outline-indigo-600 {{ current ? 'text-slate-900 dark:text-white' : 'text-slate-600 hover:text-slate-900 dark:text-slate-300 dark:hover:text-white' }}">
                    {{ label|trans }}
                </a>
            {% endfor %}
            {% if is_granted('ROLE_ADMIN') %}
                {% set current = app.current_route starts with 'app_admin' %}
                <a href="{{ path('app_admin') }}" {{ current ? 'aria-current="page"' }}
                   class="rounded px-2 py-1 text-sm font-medium focus-visible:outline-2 focus-visible:outline-indigo-600 {{ current ? 'text-slate-900 dark:text-white' : 'text-slate-600 hover:text-slate-900 dark:text-slate-300 dark:hover:text-white' }}">
                    {{ 'nav.admin'|trans }}
                </a>
            {% endif %}
        {% endif %}
        </div>

        <div class="flex items-center gap-3 text-sm">
            {% if app.user %}
                <form method="get" action="{{ path('app_search') }}" role="search" class="hidden md:block">
                    <label for="nav-search" class="sr-only">{{ 'search.label'|trans }}</label>
                    <input id="nav-search" type="search" name="q" value="{{ app.current_route == 'app_search' ? app.request.query.get('q') }}" minlength="2" maxlength="100"
                           placeholder="{{ 'search.placeholder'|trans }}"
                           class="w-56 rounded-md border border-slate-300 bg-slate-50 px-3 py-1.5 text-sm focus:border-indigo-500 focus:bg-white focus:outline-2 focus:outline-indigo-500 dark:border-slate-700 dark:bg-slate-800">
                </form>
                <twig:Link href="{{ path('app_search') }}" class="md:hidden"><span aria-hidden="true">🔍</span><span class="sr-only">{{ 'search.title'|trans }}</span></twig:Link>
                <span class="hidden text-slate-600 sm:inline dark:text-slate-300">{{ app.user.fullName }}</span>
                <form method="post" action="{{ logout_path() }}">
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
                    <twig:Button variant="secondary" type="submit">{{ 'nav.logout'|trans }}</twig:Button>
                </form>
            {% else %}
                <twig:Button variant="ghost" href="{{ path('app_login') }}">{{ 'nav.login'|trans }}</twig:Button>
                <twig:Button href="{{ path('app_register') }}">{{ 'nav.register'|trans }}</twig:Button>
            {% endif %}
        </div>
    </nav>
</header>
