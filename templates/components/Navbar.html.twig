<header class="border-b border-slate-200 bg-white dark:border-slate-800 dark:bg-slate-900">
    <nav class="mx-auto flex h-14 max-w-7xl items-center justify-between gap-4 px-4 sm:px-6 lg:px-8" aria-label="{{ 'nav.main'|trans }}">
        <div class="flex items-center gap-6">
        <a href="{{ path('app_home') }}" class="flex items-center gap-2 rounded text-lg font-semibold text-indigo-600 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600 dark:text-indigo-400">
            <span aria-hidden="true">📋</span> {{ 'app.name'|trans }}
        </a>
        {% if app.user %}
            {% set current = app.current_route starts with 'app_project' %}
            <a href="{{ path('app_project_index') }}" {{ current ? 'aria-current="page"' }}
               class="rounded px-2 py-1 text-sm font-medium focus-visible:outline-2 focus-visible:outline-indigo-600 {{ current ? 'text-slate-900 dark:text-white' : 'text-slate-600 hover:text-slate-900 dark:text-slate-300 dark:hover:text-white' }}">
                {{ 'nav.projects'|trans }}
            </a>
        {% endif %}
        </div>

        <div class="flex items-center gap-3 text-sm">
            {% if app.user %}
                <span class="hidden text-slate-600 sm:inline dark:text-slate-300">{{ app.user.fullName }}</span>
                <form method="post" action="{{ logout_path() }}">
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
                    <twig:Button variant="secondary" type="submit">{{ 'nav.logout'|trans }}</twig:Button>
                </form>
            {% else %}
                <twig:Button variant="ghost" href="{{ path('app_login') }}">{{ 'nav.login'|trans }}</twig:Button>
                <twig:Button href="{{ path('app_register') }}">{{ 'nav.register'|trans }}</twig:Button>
            {% endif %}
        </div>
    </nav>
</header>
