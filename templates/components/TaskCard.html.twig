{% props task, commentCount = 0, sortable = false %}
{% set checklist_total = task.checklistItems|length %}
<li class="group relative rounded-md bg-white p-3 text-sm shadow-xs ring-1 ring-slate-200 hover:ring-indigo-400 focus-within:ring-2 focus-within:ring-indigo-500 dark:bg-slate-800 dark:ring-slate-700"
    {% if sortable and is_granted('TASK_EDIT', task) %}data-sortable-url="{{ path('app_task_move', {id: task.id}) }}"{% endif %}>
    {% if task.labels is not empty %}
        <div class="mb-2 flex flex-wrap gap-1">
            {% for label in task.labels %}<twig:LabelChip :label="label" />{% endfor %}
        </div>
    {% endif %}
    <div class="flex items-start gap-2">
        {% if is_granted('TASK_COMPLETE', task) %}
            <twig:TaskToggle :task="task" :returnTo="app.request.requestUri" class="mt-0.5" />
        {% endif %}
        <a href="{{ path('app_task_show', {id: task.id}) }}" data-turbo-frame="modal"
           class="block min-w-0 font-medium break-words after:absolute after:inset-0 focus-visible:outline-none {{ task.completed ? 'text-slate-400 line-through' }}">
            {{ task.title }}
        </a>
    </div>
    {% if task.priority.value in ['high', 'urgent'] or task.dueDate or task.assignee or task.description or commentCount > 0 or checklist_total > 0 %}
        <div class="mt-2 flex flex-wrap items-center gap-2 text-xs text-slate-500 dark:text-slate-400">
            {% if task.priority.value in ['high', 'urgent'] %}
                <twig:PriorityBadge :priority="task.priority" />
            {% endif %}
            <twig:DueDate :task="task" />
            {% if task.description %}
                <span title="{{ 'task.has_description'|trans }}"><span aria-hidden="true">≡</span><span class="sr-only">{{ 'task.has_description'|trans }}</span></span>
            {% endif %}
            {% if checklist_total > 0 %}
                {% set checklist_done = task.countDoneChecklistItems %}
                <span class="{{ checklist_done == checklist_total ? 'font-semibold text-emerald-700 dark:text-emerald-400' }}">
                    <span aria-hidden="true">☑</span> {{ checklist_done }}/{{ checklist_total }}
                    <span class="sr-only">{{ 'checklist.progress'|trans({'%done%': checklist_done, '%total%': checklist_total}) }}</span>
                </span>
            {% endif %}
            {% if commentCount > 0 %}
                <span><span aria-hidden="true">💬</span> {{ commentCount }}<span class="sr-only"> {{ 'comment.count'|trans({'%count%': commentCount}) }}</span></span>
            {% endif %}
            {% if task.assignee %}
                <twig:Avatar :user="task.assignee" class="ml-auto" />
            {% endif %}
        </div>
    {% endif %}
</li>
