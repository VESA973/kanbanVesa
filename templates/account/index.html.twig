{% extends 'base.html.twig' %}

{% block title %}{{ 'account.title'|trans }} · {{ parent() }}{% endblock %}

{% block body %}
    {% set user = app.user %}
    <div class="mx-auto max-w-2xl">
        <h1 class="mb-6 text-2xl font-bold tracking-tight">{{ 'account.title'|trans }}</h1>

        <section class="mb-6 rounded-lg bg-white p-6 shadow-sm ring-1 ring-slate-200 dark:bg-slate-900 dark:ring-slate-800" aria-labelledby="account-info-title">
            <h2 id="account-info-title" class="mb-3 text-lg font-semibold">{{ 'account.info'|trans }}</h2>
            <dl class="grid gap-x-6 gap-y-2 text-sm sm:grid-cols-[auto_1fr]">
                <dt class="text-slate-500 dark:text-slate-400">{{ 'user.email'|trans }}</dt>
                <dd class="font-medium break-all">{{ user.email }}</dd>
                <dt class="text-slate-500 dark:text-slate-400">{{ 'account.role'|trans }}</dt>
                <dd>{{ (user.admin ? 'account.role_admin' : 'account.role_user')|trans }}</dd>
                <dt class="text-slate-500 dark:text-slate-400">{{ 'account.email_status'|trans }}</dt>
                <dd>{{ (user.verified ? 'admin.users.badge.verified' : 'admin.users.badge.unverified')|trans }}</dd>
                <dt class="text-slate-500 dark:text-slate-400">{{ 'account.member_since'|trans }}</dt>
                <dd>{{ user.createdAt|date('d/m/Y') }}</dd>
            </dl>
            <p class="mt-3 text-xs text-slate-500 dark:text-slate-400">{{ 'account.role_help'|trans }}</p>
        </section>

        <section class="mb-6 rounded-lg bg-white p-6 shadow-sm ring-1 ring-slate-200 dark:bg-slate-900 dark:ring-slate-800" aria-labelledby="account-profile-title">
            <h2 id="account-profile-title" class="mb-4 text-lg font-semibold">{{ 'account.profile'|trans }}</h2>
            {{ form_start(profile, {attr: {novalidate: 'novalidate'}}) }}
                <div class="grid gap-x-4 sm:grid-cols-2">
                    {{ form_row(profile.firstName) }}
                    {{ form_row(profile.lastName) }}
                </div>
                <twig:Button type="submit">{{ 'action.save'|trans }}</twig:Button>
            {{ form_end(profile) }}
        </section>

        <section class="rounded-lg bg-white p-6 shadow-sm ring-1 ring-slate-200 dark:bg-slate-900 dark:ring-slate-800" aria-labelledby="account-password-title">
            <h2 id="account-password-title" class="mb-4 text-lg font-semibold">{{ 'account.password.title'|trans }}</h2>
            {{ form_start(password, {attr: {novalidate: 'novalidate'}}) }}
                {{ form_row(password.currentPassword) }}
                {{ form_row(password.plainPassword.first) }}
                {{ form_row(password.plainPassword.second) }}
                <twig:Button type="submit">{{ 'account.password.submit'|trans }}</twig:Button>
            {{ form_end(password) }}
        </section>
    </div>
{% endblock %}
