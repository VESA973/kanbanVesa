{% extends 'base.html.twig' %}

{% block title %}{{ 'admin.title'|trans }} · {{ parent() }}{% endblock %}

{% block body %}
    <div class="mx-auto max-w-5xl">
        <h1 class="mb-4 text-2xl font-bold tracking-tight">{{ 'admin.title'|trans }}</h1>
        <nav aria-label="{{ 'admin.title'|trans }}" class="mb-6 flex gap-6 border-b border-slate-200 text-sm dark:border-slate-800">
            {% for route, label in {app_admin_users: 'admin.users.title', app_admin_smtp: 'admin.smtp.title', app_admin_emails: 'admin.emails.title'} %}
                {% set current = app.current_route starts with route %}
                <a href="{{ path(route) }}" {{ current ? 'aria-current="page"' }}
                   class="-mb-px border-b-2 px-1 py-2 font-medium focus-visible:outline-2 focus-visible:outline-indigo-600 {{ current ? 'border-indigo-600 text-indigo-700 dark:text-indigo-300' : 'border-transparent text-slate-600 hover:text-slate-900 dark:text-slate-300 dark:hover:text-white' }}">
                    {{ label|trans }}
                </a>
            {% endfor %}
        </nav>
        {% block admin_content %}{% endblock %}
    </div>
{% endblock %}
