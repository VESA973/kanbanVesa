{% extends 'admin/_layout.html.twig' %}

{% block admin_content %}
    <p class="mb-4 text-sm text-slate-600 dark:text-slate-300">{{ 'admin.emails.intro'|trans({'%count%': limit}) }}</p>

    {% if logs is empty %}
        <p class="rounded-lg bg-white p-6 text-sm text-slate-500 shadow-sm ring-1 ring-slate-200 dark:bg-slate-900 dark:text-slate-400 dark:ring-slate-800">{{ 'admin.emails.empty'|trans }}</p>
    {% else %}
        <div class="overflow-x-auto rounded-lg bg-white shadow-sm ring-1 ring-slate-200 dark:bg-slate-900 dark:ring-slate-800">
            <table class="min-w-full divide-y divide-slate-200 text-left text-sm dark:divide-slate-800">
                <thead class="bg-slate-50 text-xs font-medium text-slate-600 uppercase dark:bg-slate-800 dark:text-slate-300">
                    <tr>
                        <th scope="col" class="px-4 py-3">{{ 'admin.emails.date'|trans }}</th>
                        <th scope="col" class="px-4 py-3">{{ 'admin.emails.recipients'|trans }}</th>
                        <th scope="col" class="px-4 py-3">{{ 'admin.emails.subject'|trans }}</th>
                        <th scope="col" class="px-4 py-3">{{ 'admin.emails.status_label'|trans }}</th>
                        <th scope="col" class="px-4 py-3">{{ 'admin.emails.message_id'|trans }} / {{ 'admin.emails.error'|trans }}</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-200 dark:divide-slate-800">
                    {% for log in logs %}
                        {% set status = log.status.value %}
                        <tr>
                            <td class="px-4 py-3 whitespace-nowrap tabular-nums">{{ log.createdAt|date('d/m/Y H:i:s') }}</td>
                            <td class="px-4 py-3 break-all">{{ log.recipients }}</td>
                            <td class="px-4 py-3">{{ log.subject }}</td>
                            <td class="px-4 py-3 whitespace-nowrap">
                                <span class="rounded-full px-2 py-0.5 text-xs font-medium {{ {
                                    sent: 'bg-emerald-100 text-emerald-900 dark:bg-emerald-900/40 dark:text-emerald-100',
                                    failed: 'bg-rose-100 text-rose-900 dark:bg-rose-900/40 dark:text-rose-100',
                                    not_configured: 'bg-amber-100 text-amber-900 dark:bg-amber-900/40 dark:text-amber-100',
                                }[status] }}">{{ log.status.translationKey|trans }}</span>
                            </td>
                            <td class="px-4 py-3 font-mono text-xs break-all">
                                {% if log.error %}
                                    <span class="text-rose-700 dark:text-rose-300">{{ log.error }}</span>
                                {% else %}
                                    {{ log.messageId ?? '—' }}
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
{% endblock %}
