[Unit]
Description=Mercure hub (TaskBoard real time)
After=network.target

[Service]
# Dedicated, unprivileged user created on the fly; /var/lib/mercure holds the Bolt database.
DynamicUser=yes
StateDirectory=mercure
EnvironmentFile=/etc/mercure/mercure.env
ExecStart=/usr/local/bin/mercure run --config /etc/mercure/Caddyfile
Restart=on-failure
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
